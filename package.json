{
  "name": "atlas-lite-mcp",
  "version": "0.1.0",
  "description": "Fast local MCP server for Jira Cloud and Confluence Cloud with surgical, lossless page edits.",
  "type": "module",
  "license": "MIT",
  "author": "Andrija Peric",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pandalabs-dev/atlas-lite-mcp.git"
  },
  "keywords": [
    "mcp",
    "jira",
    "confluence",
    "atlassian",
    "model-context-protocol"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:smoke": "vitest run --config vitest.smoke.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "domhandler": "6.0.1",
    "entities": "8.1.0",
    "fast-xml-parser": "5.12.0",
    "htmlparser2": "12.0.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
